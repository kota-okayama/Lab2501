# Python関連の一般的な除外ファイル
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 仮想環境
venv/
env/
ENV/

# IDE関連
.idea/
.vscode/
*.swp
*.swo

# その他の一般的な除外ファイル
.DS_Store
.env
.env.local
.env.*.local

# プロジェクト固有の除外設定
# .py以外のファイルを除外（ただし重要なファイルは明示的に含める）
*
!*.py
!*.sh
!*.md
!*.txt
!*.yml
!*.yaml
!.gitignore
!openai_embedding_experiment/
!/Dockerfile
!/.dockerignore
!/siamese_model_pytorch/

# JSONファイルの取り扱い
*.json
!llm_api_cache.json

# ベンチマークデータ（大きなファイルは除外）
benchmark/bib_japan_20241024/* 

# FastTextモデル（大きなファイルは除外）
fasttext/*
!fasttext/init.py
fasttext_models/*.bin
fasttext_models/*.gz

# パイプライン出力
pipeline*/**

# 学習済みモデル
*.pth
*.pkl
*.npy

# ログファイル
*.log